.service-block {
	display: flex;
	align-items: center;
	gap: 30px;
	margin: 30px 0px;
	padding: 25px 0px;
}

.service-block.reverse {
	flex-direction: row-reverse;
}

.service-text {
	flex: 1;
}

.service-text h3 {
	margin-top: 0px;
	color: var(--headers-color);
}

.service-image {
	flex: 0 0 220px;
}

.service-image img {
	width: 100%;
	border-radius: 8px;
	display: block;
	object-fit: cover;
}

.service-header {
	flex: 0 0 220px;
	width: 200px;
	/* align-self: flex-start; */
}
/* .service-header h3 {
} */

.service-divider {
	border: none;
	height: 2px;
	margin: 10px auto;
	width: 80%;
	background: linear-gradient(to right, transparent, var(--hr-color), transparent);
}

.contact-page {
	max-width: 525px;
	margin: 0px auto;
}

.contact-reason {
	margin: 20px auto 30px;
	text-align: center;
}

.contact-reason label {
	font-weight: 700;
	display: block;
	margin-bottom: 4px;
}

.contact-reason select {
	width: 100%;
	padding: 8px 10px;
	border: 1px solid #cccccc;
	border-radius: 6px;
	font-family: inherit;
	font-size: 14px;
	color: var(--text-color);
	background-color: white;
	text-align: center;
	text-align-last: center;
}

.consultation-form {
	display: flex;
	flex-direction: column;
	gap: 16px;
	margin: 20px 0px;
}

.consultation-form label {
	font-weight: 700;
	display: block;
	margin-bottom: 4px;
}

.consultation-form input[type="text"],
.consultation-form textarea {
	width: 100%;
	padding: 8px 10px;
	border: 1px solid #cccccc;
	border-radius: 6px;
	font-family: inherit;
	font-size: 14px;
	color: var(--text-color);
}

.consultation-form textarea {
	min-height: 120px;
	resize: vertical;
}

.consultation-form .radio-group label {
	font-weight: 400;
	display: inline-flex;
	align-items: center;
	gap: 6px;
	margin-right: 20px;
}

.consultation-form button {
	align-self: flex-start;
	background-color: var(--highlight-color);
	color: white;
	border: none;
	padding: 10px 24px;
	border-radius: 6px;
	font-size: 15px;
	cursor: pointer;
}

.consultation-form button:hover {
	opacity: 0.9;
}

.form-hint {
	font-size: 12px;
	color: #888888;
	margin-top: 4px;
}

h1, h2, #navbar {
	font-family: Arial, Helvetica, sans-serif;
}

#footer {
	width: 100%;
	height: var(--header-size);
	line-height: var(--header-size);
	text-align: center;
	background-color: var(--topbar-color);
}

#footer a {
	text-decoration: none;
	color: #888888;
}

#footer a:hover {
	text-decoration: underline;
}

@media only screen and (max-width: 768px) {
	#title div {
		font-size: 3vw;
	}
	#title h1 {
		font-size: 7vw;
	}
	#content {
		padding: 20px;
		max-width: none;
		width: 100%;
	}
	#amandaimg {
		float: none;
		margin: auto;
		display: block;
	}
	.service-block,
	.service-block.reverse {
		flex-direction: column;
	}
	.service-image {
		flex: none;
		width: 60%;
	}
}


.reveal {
	opacity: 0;
	transition: opacity 0.7s ease, transform 0.7s ease;
}
.reveal--left  { transform: translateX(-80%); }
.reveal--right { transform: translateX(80%); }

.reveal.is-visible {
	opacity: 1;
	transform: none;
}


section.callout {
	padding: 1em 2em;
	background: var(--callout-color);
}

.citation {
	color: grey;
}

.faq-list {
	margin: 25px 0px;
}

.faq-item {
	background: var(--callout-color);
	margin-bottom: 12px;
	border-left: 4px solid var(--highlight-color);
}

.faq-item summary {
	cursor: pointer;
	padding: 14px 20px;
	font-weight: 700;
	list-style: none;
	display: flex;
	justify-content: space-between;
	align-items: center;
	gap: 15px;
}

.faq-item summary::-webkit-details-marker {
	display: none;
}

.faq-item summary::after {
	content: "+";
	font-size: 22px;
	line-height: 1;
	color: var(--highlight-color);
	transition: transform 0.3s ease;
}

.faq-item[open] summary::after {
	transform: rotate(45deg);
}

.faq-answer {
	padding: 0px 20px 4px;
}

.faq-item[open] .faq-answer {
	animation: faq-fade-in 0.5s ease;
}

@keyframes faq-fade-in {
	from {
		opacity: 0;
		transform: translateY(-8px);
	}
	to {
		opacity: 1;
		transform: none;
	}
}

@media (prefers-reduced-motion: reduce) {
	.reveal {
		opacity: 1;
		transform: none;
		transition: none;
	}
	.faq-item[open] .faq-answer {
		animation: none;
	}
}