.officeimg {
	width: 300px !important;
}


#navbarcontainer { 
	position: relative;
	width: 100%;
	height: var(--navbar-height);
	margin-bottom: 25px;
}

#navbar {
	position: absolute;
	left: 50%;
	transform: translateX(-50%);
	top: 0px;
	width: 100vw;
	background-color: var(--navbar-color);
	height: var(--navbar-height);
	view-transition-name: navbar;
}

#navbar > div {
	margin: auto;
	width: fit-content;
}

#navbar a {
	color: white;
	text-decoration: none;
	line-height: var(--navbar-height);
	margin: 0px 20px;
	cursor: pointer;
}

#navbar a:hover,
#navbar a.active {
	border-bottom: 2px solid white;
}




#amandaimg img {
	--widththing: 250px;
	position: relative;
	width: var(--widththing);
	float: none;
	margin: auto;
	display: block;
	border-radius: calc(var(--widththing) / 2);
	z-index: 1000;
	border: 6px solid #232a23;
	/* TODO: remake the border via a div so we dont have the white lil pixles  */
}

.amandahome .callout {
	max-width: 600px;
	margin: auto;
	font-size: 24px;
	/* margin-top: -40px; */
	position: relative;
	border: 4px solid var(--darksage-color);
	text-align: center;
}

.amandahome hr.service-divider {
	/* position: absolute;
	top: 20px; */
	margin-top: 30px;
	background: linear-gradient(to right, transparent, var(--hr-color), transparent);;
}
