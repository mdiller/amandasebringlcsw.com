---
permalink: /style.css
---
:root {
	--topbar-color: #333333;
	--highlight-color: #7d986d;
	--text-color: #555555;
	--background-sage-light: #c7cdbf;
	--background-cream: #ece4d9;
	--content-size: 1000px;
	--header-size: 50px;
	--navbar-height: 50px;

	--darksage-color: #516153;
	--navbar-color: #748b76;
	--background-color: var(--background-cream);
	--callout-color: var(--background-sage-light);
	--hr-color: var(--darksage-color);
	--headers-color: var(--darksage-color);
}

@view-transition {
	navigation: auto;
}

* {
	box-sizing: border-box;
}

/* TODO: update all the text used on the site to use "em"-based sizes */

html, body {
	font-family: Open Sans, Source Sans Pro, Lato, Roboto, Arial, Helvetica, sans-serif;
	background-color: var(--background-cream);
	color: var(--text-color);
	height: 100%;
	width: 100%;
	margin: 0px;
}

#page {
	min-height: 100vh;
	display: flex;
	flex-direction: column;
}

#banner {
	width: 100%;
	padding: 8px 0px;
	text-align: center;
	font-size: 14px;
	font-weight: 700;
	letter-spacing: 0.02em;
	background-color: #e8b84b;
	color: #333333;
	view-transition-name: banner;
}

#banner a {
	color: #333333;
    cursor: pointer;
    text-decoration: none;
}

#banner a:hover {
	text-decoration: underline;
}

#title {
	position: relative;
	padding-top: var(--header-size);
	padding-bottom: 20px;
	background: url(images/banner.png?v={{ buildId }});
	background-size: 100% auto;
	background-position: center bottom;
	view-transition-name: title;
}

#title > div {
	/* position: absolute;
	top: 50%;
	transform: translate(0, -50%); */
	/* color: white; */
	text-align: center;
	font-size: 18px;
	font-weight: 700;
	width: 100%;


	/* TEXT OUTLINE */
	/* text-shadow:
			-1px -1px 0 #000,  1px -1px 0 #000,
			-1px  1px 0 #000,  1px  1px 0 #000; */
	

	/* text-shadow: 0 0 3px #000, 0 0 3px #000, 0 1px 4px #000; */

	/* -webkit-text-stroke: 3px black;
    paint-order: stroke fill; */

	filter: drop-shadow(0 0 2px black) drop-shadow(0 0 2px black);
}

#minititle {
	color: #999999;
}

#title h1 {
	color: white;
	font-size: 42px;
	font-weight: 800;
	margin: 0px;
}

#title h1 a {
	color: inherit;
	text-decoration: none;
}

#title img {
	object-fit: cover;
	width: 100%;
}

#minititle {
	padding-top: 10px;
}

h2 {
	display: block;
	top: 85px;
	line-height: 40px;
	border-bottom: 4px solid var(--headers-color);
	white-space: nowrap;
	width: fit-content;
	margin: auto;
}

#content {
	position: relative;
	max-width: var(--content-size);
	width: 100%;
	margin: auto;
	/* padding-top: 30px; */
	flex: 1;
}

/* Header stays static across page navigations instead of cross-fading with the content */
::view-transition-group(banner),
::view-transition-group(title),
::view-transition-group(navbar) {
	animation: none;
}

