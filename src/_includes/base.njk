<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{{ title }} | Amanda Sebring, LCSW</title>
	<link rel="stylesheet" href="/style.css">
	<link href="https://fonts.googleapis.com/css?family=Open+Sans|Lato|Roboto|Source+Sans+Pro" rel="stylesheet">
	<meta property="og:title" content="Amanda Sebring, LCSW">
	<meta property="og:image" content="https://amandasebringlcsw.com/images/amanda.jpg">
	<meta property="og:description" content="Mental health counselor for adolescents and adults">
</head>

<body>
<div id="page">

	<div id="banner">Accepting new patients</div>

	<div id="title">
		<div>
			<h1><a href="/">Amanda Sebring, LCSW</a></h1>
			<div id="minititle">Mental Health Counselor</div>
		</div>
	</div>

	<div id="content">

		<div id="navbarcontainer">
			<nav id="navbar">
				<div>
					<a href="/" class="{{ 'active' if page.url == '/' }}">Services</a>
					<a href="/about/" class="{{ 'active' if page.url == '/about/' }}">About Me</a>
					<a href="/pricing/" class="{{ 'active' if page.url == '/pricing/' }}">Pricing</a>
				</div>
			</nav>
		</div>

		{{ content | safe }}

	</div>

	<div id="footer">
		<a href="https://github.com/mdiller/amandasebringlcsw.com">Copyright {% year %}</a>
	</div>

</div>
</body>
</html>
