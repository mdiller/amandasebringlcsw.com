---
layout: base.njk
title: Contact Me
---

<div class="contact-page">

<div class="contact-reason">
	<label for="contact-reason-select">Why are you contacting me?</label>
	<select id="contact-reason-select">
		<option value="scheduling">Scheduling / Free Consultation</option>
		<option value="licensure-supervision">Clinical Licensure Supervision</option>
	</select>
</div>

<div id="licensure-supervision-section" hidden>
	<h2 id="licensure-supervision">Clinical Licensure Supervision</h2>
	<p>Cost: $125/hour - individual licensure supervision</p>
	<p>
		For counseling and social work associates, I offer licensure supervision.
	</p>
	{# <p>
		<a href="mailto:REPLACE_WITH_AMANDAS_EMAIL?subject=Licensure%20Supervision%20Interest">
			Contact me to learn more
		</a>
	</p> #}
</div>

<div id="scheduling-section">
	<h2 id="scheduling">Scheduling / Free Consultation</h2>
	<p>
		I offer a free 15 minute consultation so you can assess whether I am a good
		fit, and so I can determine whether I am an appropriate fit for your needs.
	</p>
</div>

<hr class="service-divider">

<!--
	TODO: this form has no submission backend wired up yet - see chat for the
	options/decision needed (Formspree, Netlify Forms, a mailto fallback, etc.)
	before this can actually deliver submissions anywhere.
-->
<form class="consultation-form">
	<div>
		<label for="first-name">First name</label>
		<input type="text" id="first-name" name="first-name" required>
	</div>
	<div>
		<label for="last-name">Last name</label>
		<input type="text" id="last-name" name="last-name" required>
	</div>

	<div>
		<label>Are you reaching out for therapy for yourself or someone else?</label>
		<div class="radio-group">
			<label><input type="radio" name="reaching-out-for" value="myself" checked> Myself</label>
			<label><input type="radio" name="reaching-out-for" value="someone-else"> Someone else</label>
		</div>
	</div>

	<div id="relationship-field" hidden>
		<label for="relationship">What is your relationship with the individual you are reaching out on behalf of?</label>
		<input type="text" id="relationship" name="relationship">
	</div>

	<div>
		<label for="reason">Please provide some information about your reason for reaching out</label>
		<textarea id="reason" name="reason" maxlength="1500"></textarea>
		<div class="form-hint">1500 characters max</div>
	</div>

	<button type="submit">Submit</button>
</form>

<script>
	(function () {
		var radios = document.querySelectorAll('input[name="reaching-out-for"]');
		var relationshipField = document.getElementById('relationship-field');
		radios.forEach(function (radio) {
			radio.addEventListener('change', function () {
				relationshipField.hidden = (radio.value !== 'someone-else' || !radio.checked);
			});
		});

		document.querySelector('.consultation-form').addEventListener('submit', function (event) {
			event.preventDefault();
			alert('Not implemented yet');
		});

		var reasonSelect = document.getElementById('contact-reason-select');
		var sections = {
			'licensure-supervision': document.getElementById('licensure-supervision-section'),
			'scheduling': document.getElementById('scheduling-section')
		};
		reasonSelect.addEventListener('change', function () {
			Object.keys(sections).forEach(function (key) {
				sections[key].hidden = (key !== reasonSelect.value);
			});
		});
	})();
</script>

</div>